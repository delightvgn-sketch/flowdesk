# ---------------------------------------------------------------------------
# FlowDesk environment variables
# Copy to .env.local for local development. Never commit real values.
# ---------------------------------------------------------------------------

# --- Database (required) ----------------------------------------------------
# Postgres connection string. Local Supabase (npm run supabase:start) uses the
# value below. On Vercel use Supabase's *transaction pooler* URL (port 6543).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55422/postgres

# --- Supabase Storage (required for file uploads) ---------------------------
# Server-only. The service-role key is used exclusively on the server to sign
# short-lived upload/download URLs — it is never sent to the browser.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55421
SUPABASE_SERVICE_ROLE_KEY=

# --- Clerk authentication (required) ----------------------------------------
# https://dashboard.clerk.com → API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- App ----------------------------------------------------------------------
# Public base URL, used for invoice share links and invitation links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- FlowDesk AI (optional) -------------------------------------------------
# Vercel AI Gateway key. On Vercel, OIDC authenticates automatically and this
# can be left empty. Without either, AI features show a configuration notice
# and the rest of the app works normally.
AI_GATEWAY_API_KEY=
# Optional model override (AI Gateway model id).
# AI_MODEL=anthropic/claude-sonnet-5.5

# --- Demo & cron (optional) --------------------------------------------------
# Set DEMO_MODE=false to disable the public one-click demo.
# DEMO_MODE=true
# Set to false to stop the daily cron from resetting the demo workspace.
# DEMO_DAILY_RESET=true
# Secret Vercel Cron sends as a Bearer token to /api/cron/daily.
CRON_SECRET=
